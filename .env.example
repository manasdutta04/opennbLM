# Application
OPENNBLM_APP_NAME=opennbLM backend
OPENNBLM_APP_VERSION=0.1.0
OPENNBLM_ENVIRONMENT=development
OPENNBLM_LOG_LEVEL=INFO
OPENNBLM_CORS_ORIGINS='["http://localhost:3000"]'

# LLM provider selection/configuration
# Keep secrets server-side. Leave unset when using local Ollama.
OPENNBLM_LLM_PROVIDER=ollama
OPENNBLM_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OPENNBLM_OLLAMA_MODEL=llama3.2
OPENNBLM_GROQ_API_KEY=
OPENNBLM_GROQ_MODEL=llama-3.1-8b-instant

# Rumik local server; no model download is performed by opennbLM.
OPENNBLM_RUMIK_ENDPOINT=http://127.0.0.1:6006
OPENNBLM_RUMIK_SPEAKER=Ira
OPENNBLM_RUMIK_TEMPERATURE=0.8
OPENNBLM_RUMIK_TOP_K=30
OPENNBLM_RUMIK_MAX_NEW_TOKENS=2048

# Local SQLite memory
OPENNBLM_MEMORY_PATH=opennblm.sqlite3
